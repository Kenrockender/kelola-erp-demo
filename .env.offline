# Local-only mode (loaded by `npm run dev:local` / `npm run build:local`).
# Blank Firebase keys force isFirebaseConfigured=false → the app stores data in
# IndexedDB on this device and uses the built-in local login
# (admin / admin123 on first run — see .env.offline usernames in
# src/core/local-users.js). This is the ONLY mode this demo repo ships: there
# is no Firebase backend in this repo at all (see README.md).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_USE_EMULATORS=false

VITE_APP_NAME=Kelola ERP (Demo)
VITE_APP_VERSION=1.0.0
